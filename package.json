{
	"name": "obsidian-quantities",
	"version": "0.6.0",
	"description": "Calculate with quantities, variables, units, and scoped aggregates directly in your notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
